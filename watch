#!/usr/bin/env bash
cd "$(dirname "$0")" || exit 1

C=lib/compile.py
T=research/tldr/src

resolve() {
  a="${1%.mdtx}"; a="${a%/}"
  case "$a" in
    tldr|tldrs|research/tldr) echo "$T" ;;
    tldr/*|tldrs/*|research/tldr/*) echo "$T/${a##*/}.mdtx" ;;
    *) echo "$T/$a.mdtx" ;;
  esac
}

if [ $# -eq 0 ]; then
  python3 "$C" "$T"
else
  t=$(resolve "$1")
  [ -e "$t" ] || { echo "no such source: $t" >&2; exit 1; }
  python3 "$C" "$t"
fi
